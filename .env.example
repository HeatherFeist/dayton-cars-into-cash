# Public anon key only. These values ship in the built JavaScript.
# Set them in Cloudflare Pages → Settings → Environment variables, then rebuild.
# Leave blank to skip the database: the quote form still shows a ballpark
# and can text/email the yard. The private dashboard needs these.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Instant phone alert when a lead is saved. See PUSHOVER_SETUP.md.
# Also ships in the built JavaScript. Leave blank to skip.

VITE_PUSHOVER_TOKEN=
VITE_PUSHOVER_USER=
